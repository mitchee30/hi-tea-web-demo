# 复制这个文件为 .env，然后填上你自己的值。.env 不会被提交到 GitHub。
# Copy this file to .env and fill in your own values. .env is never committed.

# 店员后台登录 PIN（必填，上线时一定要改）/ Staff dashboard PIN (required in production)
ADMIN_PIN=1234

# 网站的公开网址，用于 Stripe 跳转和桌号二维码。本地开发可以不填。
# Public URL of the site, used for Stripe redirects and table QR codes. Optional locally.
# PUBLIC_URL=https://hi-tea.onrender.com

# Stripe 测试模式密钥（不填就只能到店付款）/ Stripe test keys (leave blank to disable online payment)
# 在 https://dashboard.stripe.com/test/apikeys 获取
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# 端口 / Port
# PORT=3000
